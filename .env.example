# Copia este archivo como ".env" y rellena los valores reales.
# El archivo .env NO se sube a Git (está en .gitignore).

# Clave secreta de Django (genera una larga y aleatoria)
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# En local True; en producción SIEMPRE False
DEBUG=True

# Hosts permitidos, separados por coma
ALLOWED_HOSTS=127.0.0.1,localhost

# Conexión a PostgreSQL: postgres://USUARIO:CLAVE@HOST:PUERTO/BASEDEDATOS
DATABASE_URL=postgres://matriculas_user:tu_password@localhost:5432/matriculas_db
